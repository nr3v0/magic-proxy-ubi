# Sample systemd unit to run the image with Podman on a traditional host.
#
# Install:
#   sudo cp examples/magic-proxy.service /etc/systemd/system/
#   sudo mkdir -p /etc/magic-proxy
#   sudo cp examples/acme.env.example     /etc/magic-proxy/acme.env   # then edit secrets
#   sudo cp examples/domains.txt.example  /etc/magic-proxy/domains.txt
#   sudo chmod 600 /etc/magic-proxy/acme.env
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now magic-proxy.service
#
# Reload the domain list at runtime without restarting:
#   sudo podman kill -s USR1  magic-proxy   # force an immediate ACME reload
#   (or) edit domains.txt and wait for the next poll

[Unit]
Description=HAProxy 3.3 (UBI10) + Data Plane API + ACME DNS-01 agent
Wants=network-online.target
After=network-online.target

[Service]
Environment=IMAGE=quay.openshift.works/nrevo/magic-proxy-ubi:latest
# Pre-pull so the unit fails fast if the image is unavailable.
ExecStartPre=-/usr/bin/podman pull ${IMAGE}
ExecStartPre=-/usr/bin/podman rm -f magic-proxy
ExecStart=/usr/bin/podman run \
    --name magic-proxy \
    --replace \
    --env-file /etc/magic-proxy/acme.env \
    -v /etc/magic-proxy/domains.txt:/etc/haproxy/acme/domains.txt:ro,Z \
    -v magic-proxy:/etc/haproxy/acme:Z \
    --cap-add=NET_BIND_SERVICE \
    -p 80:80 -p 443:443 -p 8404:8404 -p 5555:5555 \
    ${IMAGE}
ExecStop=/usr/bin/podman stop -t 15 magic-proxy
Restart=always
RestartSec=5
# The container handles SIGTERM for a graceful shutdown.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
