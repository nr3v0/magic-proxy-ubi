# Sample systemd unit to run the image with Podman on a traditional host.
#
# Install:
#   sudo cp examples/haproxy-acme.service /etc/systemd/system/
#   sudo mkdir -p /etc/haproxy-acme
#   sudo cp examples/acme.env.example     /etc/haproxy-acme/acme.env   # then edit secrets
#   sudo cp examples/domains.txt.example  /etc/haproxy-acme/domains.txt
#   sudo chmod 600 /etc/haproxy-acme/acme.env
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now haproxy-acme.service
#
# Reload the domain list at runtime without restarting:
#   sudo podman kill -s USR1  haproxy-acme   # force an immediate ACME reload
#   (or) edit domains.txt and wait for the next poll

[Unit]
Description=HAProxy 3.3 (UBI10) + Data Plane API + ACME DNS-01 agent
Wants=network-online.target
After=network-online.target

[Service]
Environment=IMAGE=ghcr.io/yourorg/magic-proxy-ubi:latest
# Pre-pull so the unit fails fast if the image is unavailable.
ExecStartPre=-/usr/bin/podman pull ${IMAGE}
ExecStartPre=-/usr/bin/podman rm -f haproxy-acme
ExecStart=/usr/bin/podman run \
    --name haproxy-acme \
    --replace \
    --env-file /etc/haproxy-acme/acme.env \
    -v /etc/haproxy-acme/domains.txt:/etc/haproxy/acme/domains.txt:ro,Z \
    -v haproxy-acme:/etc/haproxy/acme:Z \
    -p 8080:8080 -p 8443:8443 -p 8404:8404 -p 5555:5555 \
    ${IMAGE}
ExecStop=/usr/bin/podman stop -t 15 haproxy-acme
Restart=always
RestartSec=5
# The container handles SIGTERM for a graceful shutdown.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
