# Example env file for the ACME DNS-01 agent.
# Copy to a secure location (chmod 600) and fill in real values.
# DO NOT commit a filled-in copy to version control.

ACME_ENABLED=true
ACME_CA=letsencrypt            # use letsencrypt_test while experimenting
ACME_DOMAINS_FILE=/etc/haproxy/acme/acme_domains.txt
ACME_EMAIL=you@example.com
ACME_RENEW_INTERVAL=86400

# Porkbun API credentials (enable API access for the domain in the Porkbun panel)
PORKBUN_API_KEY=pk1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PORKBUN_SECRET_API_KEY=sk1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Change the Data Plane API password from its default before exposing port 5555.
DATAPLANE_USER=admin
DATAPLANE_PASS=change-me
